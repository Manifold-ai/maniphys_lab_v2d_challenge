     return Path(out_file).parent / "debug" if debug_dir is None else Path(debug_dir)
 
 
+CANDIDATE_DUMP_REVISION = "maniphys-tier3-fp-candidates-v1"
+
+
+def _write_candidate_dump(out_file: Path, calls: list[dict], names: list[str]) -> Path:
+    # maniphys tier3 patch (candidate dump): one row per FoundationPose registration call, its full ranked candidate pool
+    # in call order (call_offsets slices poses/scores/source_ids) and the full-image shortlist metrics the selector saw
+    # (shortlist_offsets slices those). Written before the pickle, so a valid pickle always has its candidates beside it.
+    path = out_file.with_suffix(".candidates.npz")
+
+    def cat(key: str, dtype, empty_shape: tuple[int, ...]) -> np.ndarray:
+        parts = [np.asarray(c[key], dtype=dtype) for c in calls]
+        return np.concatenate(parts).astype(dtype, copy=False) if parts else np.empty(empty_shape, dtype=dtype)
+
+    def offsets(key: str) -> np.ndarray:
+        return np.concatenate([[0], np.cumsum([len(c[key]) for c in calls])]).astype(np.int64)
+
+    arrays = {
+        "revision": np.asarray(CANDIDATE_DUMP_REVISION),
+        "frames": np.asarray(names),
+        "call_frame": np.asarray([c["frame"] for c in calls], dtype=np.int32),
+        "call_seed": np.asarray([c["seed"] for c in calls], dtype=np.int64),
+        "call_rgb_only": np.asarray([c["rgb_only"] for c in calls], dtype=bool),
+        "call_screen_all": np.asarray([c["screen_all"] for c in calls], dtype=bool),
+        "call_cluster_angle_deg": np.asarray([c["cluster_angle_deg"] for c in calls], dtype=np.float32),
+        "call_observed_visible_pixels": np.asarray([c["observed_visible_pixels"] for c in calls], dtype=np.int64),
+        "call_transform_to_centered": np.asarray([c["transform_to_centered"] for c in calls], dtype=np.float32).reshape(-1, 4, 4),
+        "call_offsets": offsets("scores"),
+        "poses_centered": cat("poses_centered", np.float32, (0, 4, 4)),
+        "scores": cat("scores", np.float32, (0,)),
+        "source_ids": cat("source_ids", np.int64, (0,)),
+        "shortlist_offsets": offsets("shortlist_source_ids"),
+        "shortlist_source_ids": cat("shortlist_source_ids", np.int64, (0,)),
+    }
+    for key in SHORTLIST_METRIC_FIELDS:
+        arrays[f"shortlist_{key}"] = cat(f"shortlist_{key}", np.float32, (0,))
+    tmp = path.with_name(f".{path.stem}.{os.getpid()}.tmp.npz")
+    np.savez_compressed(tmp, **arrays)
+    os.replace(tmp, path)
+    return path
+
+
+SHORTLIST_METRIC_FIELDS = ("iou", "precision", "recall", "rendered_visibility", "rendered_visible_pixels", "centroid_distance")
+
