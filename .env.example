# 复制成 .env 后填写真实值。.env 已在 .gitignore 里，不会进 git。
# 训练机（SSH 别名见 ~/.ssh/config）
V2D_HOST=mf4090
V2D_REMOTE=/home/rxzhou/v2d/maniphys_lab_v2d_challenge
# 其他训练机：另建 .env.<名字>，只写 V2D_HOST 与 V2D_REMOTE，用 V2D_ENV=<名字> 选择，例如
#   .env.ml40:  V2D_HOST=ml40
#               V2D_REMOTE=/home/rxzhou/v2d/maniphys_lab_v2d_challenge
#   V2D_ENV=ml40 scripts/dev/remote

# 国内网络出口。github / pypi 直连可达，不要走代理（大文件传输会被重置）；
# huggingface 和 Docker Hub 直连不通，需要代理或镜像。
V2D_PROXY=http://user:pass@host:port
HF_ENDPOINT=https://hf-mirror.com
